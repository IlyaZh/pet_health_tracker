{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "File": {
      "Path": "Logs/dog-health-bot-.json",
      "RetainedDays": 7
    }
  },
  "BotConfiguration": {
    "Token": "ТВОЙ_ТОКЕН_ОТ_BOTFATHER",
    "AllowedUsers": [],
    // Options: Polling, Webhook
    "UpdateMode": "Polling",
    // Required only for Webhook
    "WebhookUrl": "https://your_domain.com/bots/dogs-health-tracker"
    // SecretToken for webhook mode
    "SecretToken": "secret_token"
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=db;User=user;Password=password;CharSet=utf8mb4;"
  }
}